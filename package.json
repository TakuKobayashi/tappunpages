{
  "name": "taptappun-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/optimize-images.ts && next build && tsx scripts/localize-static-html.ts",
    "lint": "next lint",
    "deploy": "next build && wrangler deploy",
    "deploy:preview": "next build && wrangler deploy --env preview",
    "worker:dev": "wrangler dev",
    "cf:secret": "wrangler secret put",
    "cf:tail": "wrangler tail",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "build:noopt": "next build"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.4",
    "sharp": "^0.34.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.19.0"
  }
}
